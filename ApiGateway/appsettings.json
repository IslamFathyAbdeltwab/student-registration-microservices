{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "students-route": {
        "ClusterId": "students-cluster",
        "Match": {
          "Path": "/students/{**catch-all}"
        }
      },
      "courses-route": {
        "ClusterId": "courses-cluster",
        "Match": {
          "Path": "/courses/{**catch-all}"
        }
      },
      "enroll-route": {
        "ClusterId": "enrollment-cluster",
        "Match": {
          "Path": "/enroll/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "students-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://studentservice1:8080/"
          },
          "destination2": {
            "Address": "http://studentservice2:8080/"
          }
        }
      },
      "courses-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://courseservice:8080/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://enrollmentservice:8080/"
          }
        }
      }
    }
  }
}